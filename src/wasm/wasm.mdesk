@enum(u8) WASM_OpKind:
{
    @expand(WASM_OpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

@enum(u8) WASM_GcOpKind:
{
    @expand(WASM_GcOpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

@enum(u8) WASM_MiscOpKind:
{
    @expand(WASM_MiscOpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

@enum(u16) WASM_SimdOpKind:
{
    @expand(WASM_SimdOpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

