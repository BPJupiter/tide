@enum(u8) WASM_OpKind:
{
    @expand(WASM_OpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

@enum2string_switch(WASM_OpKind)
wasm_string_from_opkind:
{
    @expand(WASM_OpTable a) `case WASM_OpKind_$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name):{result = s("$(a.name == _ -> "reserved."..a.id)$(a.name != _ -> a.string)");}break`;
}

@enum(u8) WASM_GcOpKind:
{
    @expand(WASM_GcOpTable a) `$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name) = $(a.id)`,
}

@enum2string_switch(WASM_GcOpKind)
wasm_string_from_gcopkind:
{
    @expand(WASM_GcOpTable a) `case WASM_GcOpKind_$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name):{result = s("$(a.name == _ -> "reserved."..a.id)$(a.name != _ -> a.string)");}break`;
}

