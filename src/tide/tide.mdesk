            theme_color:{tags: "drop_site border", value: 0xffffff0f}
        }
        ```
    }
}

@enum TI_ThemePreset:
{
    @expand(TI_ThemePresetTable a) `$(a.name)`,
    COUNT,
}

@data(String8) ti_theme_preset_display_string_table:
{
    @expand(TI_ThemePresetTable a) `str8_lit_comp("$(a.display_string)")`,
}

@data(String8) ti_theme_preset_code_string_table:
{
    @expand(TI_ThemePresetTable a) `str8_lit_comp("$(a.name_lower)")`,
}

@data(String8) ti_theme_preset_cfg_string_table:
{
    @expand(TI_ThemePresetTable a) `str8_lit_comp("$(a.cfg)")`,
}

