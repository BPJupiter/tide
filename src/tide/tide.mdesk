    {DisableTarget                0   1        1              "query:targets"    Cfg         0  0  0  0  0  1  1                            CheckHollow           "disable_target"            "Disable Target"                 "Disables a target."                                                                                             ""                               ""        }
    {RemoveTarget                 0   1        1              "query:targets"    Cfg         0  0  0  0  0  1  1                            Trash                 "remove_target"             "Remove Target"                  "Removes a target."                                                                                              "delete"                         ""        }

    // query stack
    {PushQuery                    0   0        0              ""                 Null        0  0  0  0  0  0  0                            Null                  "push_query"                "Push Query"                     "Opens a new temporary query interface."                                                                         ""                               ""        }
    {CompleteQuery                0   0        0              ""                 Null        0  0  0  0  0  0  0                            Null                  "complete_query"            "Complete Query"                 "Completes and closes a query."                                                                                  ""                               ""        }
    {CancelQuery                  0   0        0              ""                 Null        0  0  0  0  0  0  0                            Null                  "cancel_query"              "Cancel Query"                   "Closes a query."                                                                                                ""                               ""        }
    {CancelAllQueries             0   0        0              ""                 Null        0  0  0  0  0  0  0                            Null                  "cancel_all_queries"        "Cancel All Queries"             "Closes all queries."                                                                                            ""                               ""        }
    {UpdateQuery                  0   0        0              ""                 Null        0  0  0  0  0  0  0                            Null                  "update_query"              "Update Query"                   "Updates a query input."                                                                                         ""                               ""        }

    // developer commands
    {ToggleDevMenu                0   1        1              ""                 Null        0  0  0  0  0  0  0                            Null                  "toggle_dev_menu"           "Toggle Developer Menu"          "Opens and closes the developer menu."                                                                           ""                               ""        }
}

@enum TI_CmdKind:
{
    `Null`,
    @expand(TI_CmdTable a) `$(a.name)`,
    @expand(TI_WatchTabFastPathTable a) `Open$(a.name)`,
    @expand(TI_ViewTabFastPathTable a) `Open$(a.name)`,
    COUNT,

    `FirstTabFastPathCmd = TI_CmdKind_OpenTargets`,
}

@struct TI_Query:
{
    `TI_QueryFlags flags`;
    `TI_RegSlot slot`;
    `String8 expr`;
}

@struct TI_Cmd_Kind_Info:
{
    `String8 string`;
    `String8 description`;
    `String8 search_tags`;
    `String8 filter_tags`;
    `TI_CmdKindFlags flags`;
    `TI_Query query`;
}

@data(TI_Cmd_Kind_Info) @c_file ti_cmd_kind_info_table:
{
    `{0}`,
    @expand(TI_CmdTable a)
        ```{ str8_lit_comp("$(a.string)"), str8_lit_comp("$(a.desc)"), str8_lit_comp("$(a.search_tags)"), str8_lit_comp("$(a.filter_tags)"),  TI_CmdKindFlag_ListInUI*$(a.ui_vis), {(TI_QueryFlag_AllowFiles*$(a.q_allow_files))|(TI_QueryFlag_AllowFolders*$(a.q_allow_folders))|(TI_QueryFlag_CodeInput*$(a.q_is_code))|(TI_QueryFlag_KeepOldInput*$(a.q_keep_oi))|(TI_QueryFlag_SelectOldInput*$(a.q_select_oi))|(TI_QueryFlag_Floating*$(a.q_floating))|(TI_QueryFlag_Required*$(a.q_required)), TI_RegSlot_$(a.q_slot), str8_lit_comp("$(a.q_expr)")}}```;
    @expand(TI_WatchTabFastPathTable a)
        ```{ str8_lit_comp("$(a.name_lower)"), str8_lit_comp("Opens a $(a.display_name) tab."), {0}, str8_lit_comp("{tab_commands}"), TI_CmdKindFlag_ListInUI}```;
    @expand(TI_ViewTabFastPathTable a)
        ```{ str8_lit_comp("$(a.name_lower)"), str8_lit_comp("Opens a $(a.display_name) tab."), {0}, str8_lit_comp("{tab_commands}"), TI_CmdKindFlag_ListInUI}```;
}

