@enum BP_IconKind:
{
  @expand(BP_IconTable a) `$(a.name)`,
  COUNT,
}

@data(String8) bp_icon_kind_text_table:
{
  @expand(BP_IconTable a) `str8_lit_comp("$(a.text)")`;
}

////////////////////////////////
//~ rjf: Theme Tables
