@enum TI_IconKind:
{
    @expand(TI_IconTable a) `$(a.name)`,
    COUNT,
}

@data(String8) ti_icon_kind_text_table:
{
    @expand(TI_IconTable a) `str8_lit_comp("$(a.text)")`;
}

