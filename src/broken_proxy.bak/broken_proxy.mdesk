      theme_color:{tags: "tab background", value: 0x8080ff}
      theme_color:{tags: "tab border", value: 0x8080ff}
      theme_color:{tags: "tab inactive background", value:0}
      theme_color:{tags: "tab auto background", value: 0x800000ff}
      theme_color:{tags: "tab auto border", value: 0x8080ff}
      theme_color:{tags: "tab auto inactive background", value: 0x300000ff}
      theme_color:{tags: "tab auto inactive border", value: 0x8080ff}
      theme_color:{tags: "drop_site background", value: 0x80ff}
      theme_color:{tags: "drop_site border", value: 0xffffff}
    }
    ```
  }
}

@table(name lower_name)
BP_CodeColorTable:
{
  {CodeDefault               "code_default"}
  {CodeSymbol                "code_symbol"}
  {CodeType                  "code_type"}
  {CodeLocal                 "code_local"}
  {CodeRegister              "code_register"}
  {CodeKeyword               "code_keyword"}
  {CodeDelimiterOperator     "code_delimiter_or_operator"}
  {CodeNumeric               "code_numeric"}
  {CodeNumericAltDigitGroup  "code_numeric_alt_digit_group"}
  {CodeString                "code_string"}
  {CodeMeta                  "code_meta"}
  {CodeComment               "code_comment"}
  {CodeLineNumbers           "code_line_numbers"}
  {CodeLineNumbersSelected   "code_line_numbers_selected"}
}

@enum BP_CodeColorSlot:
{
  @expand(BP_CodeColorTable a) `$(a.name)`,
  COUNT
}

@data(String8) bp_code_color_slot_name_table:
{
  @expand(BP_CodeColorTable a) `str8_lit_comp("$(a.lower_name)")`
}

@enum BP_ThemePreset:
{
  @expand(BP_ThemePresetTable a) `$(a.name)`,
  COUNT,
}

@data(String8) bp_theme_preset_display_string_table:
{
  @expand(BP_ThemePresetTable a) `str8_lit_comp("$(a.display_string)")`,
}

@data(String8) bp_theme_preset_code_string_table:
{
  @expand(BP_ThemePresetTable a) `str8_lit_comp("$(a.name_lower)")`,
}

@data(String8) bp_theme_preset_cfg_string_table:
{
  @expand(BP_ThemePresetTable a) `str8_lit_comp("$(a.cfg)")`,
}

////////////////////////////////
//~ rjf: Help/Docs/README
//
// NOTE: rewritten from scratch. The original was entirely about
// debugging (targets, breakpoints, watch-expression views, disassembly,
// driving another debugger instance over IPC). None of that applies
// anymore, so this describes the generic app instead.

@markdown
raddbg_readme:
{
  @title "Baseline App";
  @p "This is a native, multi-window, panel-and-tab desktop application, with a built-in text viewer/editor. It's derived from The RAD Debugger's application shell, with everything specific to debugging another process removed.";
  
  @subtitle "Getting Started";
  @p "**Opening a file:** Use **Ctrl + O** or the `Open` command to open a file in a text tab.";
  @p "**Basic keybindings:**";
  @unordered_list
  {
    @p "**Ctrl + O**: Open File";
    @p "**Ctrl + F**: Search For Text (Forwards)";
    @p "**Ctrl + Comma**: Focus Next Panel";
    @p "**Ctrl + Shift + Comma**: Focus Previous Panel";
    @p "**Ctrl + Alt + Arrow Key**: Focus Panel In Direction";
    @p "**Ctrl + Tab**: Focus Next Tab";
    @p "**Ctrl + Shift + Tab**: Focus Previous Tab";
    @p "**Ctrl + W**: Close Tab";
    @p "**F1**: Open Command Palette";
  }
  @p "For the full list, see the **Commands** section.";
  
  @p "**Configuration files (users and projects):** This app stores configuration in two files: a 'user file' (windows, keybindings, theme, fonts) and a 'project file' (workspace-specific settings, recent files). Both use the same format. Both are autosaved; you do not need to save manually. Use `Open User` or `Open Project` to switch which path is in use. If a file doesn't exist at the given path, a new one is created.";
  
  @subtitle "Command-Line Usage";
  @unordered_list
  {
    @p "`--help` Displays a help menu documenting the possible command line options.";
    @p "`--user:<path>` Specifies the location of a user file to load.";
    @p "`--project:<path>` Specifies the location of a project file to load.";
    @p "`--logs:<path>` Overrides the default path to the logs folder.";
  }
  
  @subtitle "Windows, Panels, & Tabs";
  @p "Each window is subdivided into panels. Panels subdivide their window's region without overlapping. Each panel can hold multiple tabs, and has one selected tab at a time. Tabs can be dragged and dropped between panels. There is no 'special' window, panel, or tab - layouts can be arranged freely.";
  @p "You can open a new text tab with **Ctrl + O**.";
  
  @subtitle "Commands";
  @p "Nearly everything in the app, including its UI, is implemented in terms of 'commands'. You can run any command from the command palette (**F1**), or via `Run Command`.";
  @p "A list of commands and their descriptions:";
  @unordered_list
  {
    @expand(BP_CmdTable a) @p "$(a.ui_vis == 1 -> '`'..a.display_name..'` '..a.desc)";
  }
  
  @subtitle "User & Project Files";
  @p "The *user file* stores windows (including monitor, placement, and size), each window's panel layout and tabs, keybindings, theme colors, and fonts.";
  @p "The *project file* stores project settings and recently-opened projects.";
  @p "Both files can be hand-edited, since they're stored in a plain text format.";
}

//////////////////////
// Developer Toggles

@table(name)
BP_DevToggleTable:
{
    {always_refresh}
    {simulate_lag}
    {draw_ui_text_pos}
    {draw_ui_focus_debug}
    {draw_ui_box_heatmap}
    {cmd_context_tooltips}
    {updating_indicator}
}

@gen
{
    @expand(BP_DevToggleTable a) `global bool32 DEV_$(a.name) = 0;`
}

@gen
{
    `struct {bool32 *value_ptr; String8 name;} DEV_toggle_table[] =`;
    `{`;
      @expand(BP_DevToggleTable a) `{&DEV_$(a.name), str8_lit_comp("$(a.name)")},`
        `};`;
}
