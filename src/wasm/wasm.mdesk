{
    @expand(WASM_SimdOpTable a) `case WASM_SimdOpKind_$(a.name == _ -> "Reserved"..a.id)$(a.name != _ -> a.name):{result = s("$(a.name == _ -> "reserved."..a.id)$(a.name != _ -> a.string)");}break`;
